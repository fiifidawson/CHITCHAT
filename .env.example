# Copy to .env and fill in the keys you need. The default model runs locally on Ollama
# and needs no key. Keys are read as <PROVIDER>_API_KEY (see docs/MODELS.md).
# Hosted open models:
INFOMANIAK_API_KEY=
TOGETHER_API_KEY=
# Closed models, for comparison only:
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=
COHERE_API_KEY=
